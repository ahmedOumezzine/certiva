@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    var errorsList = TempData["Errors"] as List<string>;
}
@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success alert-dismissible fade show page-alert" role="alert">
        @Html.Raw(System.Net.WebUtility.HtmlEncode(success))
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Fermer"]"></button>
    </div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show page-alert" role="alert">
        @Html.Raw(System.Net.WebUtility.HtmlEncode(error))
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Fermer"]"></button>
    </div>
}
@if (errorsList != null && errorsList.Any())
{
    <div class="alert alert-danger alert-dismissible fade show page-alert" role="alert">
        <ul class="mb-0">@foreach(var e in errorsList){
        <li>@Html.Raw(System.Net.WebUtility.HtmlEncode(e))</li>
    }
</ul>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T["Fermer"]"></button>
</div>
}