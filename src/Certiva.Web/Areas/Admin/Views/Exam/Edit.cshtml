@model ExamEditViewModel
@using Certiva.Domain.Enums
@{
    var isEdit = Model.Id != Guid.Empty;
    var pageTitle = isEdit ? T["Modifier l’examen"].Value : T["Créer un examen"].Value;
    var statusLabel = T.EnumLabel(Model.Status);
    var statusClass = Model.Status switch
    {
        Status.Published => "admin-status-published",
        Status.Archived => "admin-status-archived",
        _ => "admin-status-draft"
    };
    ViewData["Title"] = pageTitle;
}
@section Breadcrumb {
    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Exam" asp-action="Index">@T["Examens"]</a></li>
    <li class="breadcrumb-item active" aria-current="page">@pageTitle</li>
}

<div class="exam-admin admin-page admin-form-page">
    <header class="admin-title-row admin-page-header admin-form-header">
        <div>
            <span class="admin-eyebrow admin-page-eyebrow">@T["GESTION DU CATALOGUE"]</span>
            <h1 class="admin-page-title">@pageTitle</h1>
            <p class="admin-page-subtitle">@(isEdit ? T["Modifiez les informations et paramètres de publication de l’examen."] : T["Ajoutez un nouvel examen au catalogue."])</p>
        </div>
        <a asp-area="Admin" asp-controller="Exam" asp-action="Index" class="admin-secondary admin-form-back-link">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7" /></svg>
            <span>@T["Retour aux examens"]</span>
        </a>
    </header>

    <form asp-area="Admin" asp-controller="Exam" asp-action="Save" method="post" class="admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="SkillsCount" />
        <div asp-validation-summary="ModelOnly" class="admin-form-validation-summary" role="alert"></div>

        <div class="admin-form-layout">
            <div class="admin-form-main">
                <section class="admin-card admin-form-section" aria-labelledby="exam-general-title">
                    <header class="admin-form-section-header">
                        <span class="admin-form-section-icon admin-icon-blue" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M7 3h7l5 5v13H5V3z" /><path d="M14 3v6h5M8 13h8M8 17h6" /></svg>
                        </span>
                        <span><h2 id="exam-general-title">@T["Informations générales"]</h2><p>@T["Informations principales de l’examen dans le catalogue."]</p></span>
                    </header>

                    <div class="admin-form-grid">
                        <div class="admin-form-field">
                            <label asp-for="Name">@T["Nom (français)"] <span class="admin-required" aria-hidden="true">*</span></label>
                            <input asp-for="Name" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Name" class="admin-field-validation"></span>
                            <small class="admin-form-help">@T["Nom affiché dans le catalogue des examens."]</small>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="Code">@T["Code"] <span class="admin-required" aria-hidden="true">*</span></label>
                            <input asp-for="Code" class="form-control" maxlength="6" autocomplete="off" />
                            <span asp-validation-for="Code" class="admin-field-validation"></span>
                            <small class="admin-form-help">@T["Code unique de l’examen (ex. ENIM, AWS)."]</small>
                        </div>
                        <div class="admin-form-field admin-field-full">
                            <label asp-for="Slug">@T["Slug (français)"] <span class="admin-required" aria-hidden="true">*</span></label>
                            <input asp-for="Slug" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Slug" class="admin-field-validation"></span>
                            <small class="admin-form-help">@T["Identifiant utilisé dans l’URL."]</small>
                        </div>
                        <div class="admin-form-field admin-field-full">
                            <label asp-for="Description">@T["Description (français)"] <span class="admin-required" aria-hidden="true">*</span></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="admin-field-validation"></span>
                            <small class="admin-form-help">@T["Une brève description de l’examen, visible dans le catalogue."]</small>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="EnglishName">@T["Name (English)"]</label>
                            <input asp-for="EnglishName" class="form-control" autocomplete="off" lang="en" />
                            <span asp-validation-for="EnglishName" class="admin-field-validation"></span>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="EnglishSlug">@T["Slug (English)"]</label>
                            <input asp-for="EnglishSlug" class="form-control" autocomplete="off" lang="en" />
                            <span asp-validation-for="EnglishSlug" class="admin-field-validation"></span>
                        </div>
                        <div class="admin-form-field admin-field-full">
                            <label asp-for="EnglishDescription">@T["Description (English)"]</label>
                            <textarea asp-for="EnglishDescription" class="form-control" rows="3" lang="en"></textarea>
                            <span asp-validation-for="EnglishDescription" class="admin-field-validation"></span>
                        </div>
                    </div>
                </section>

                <section class="admin-card admin-form-section" aria-labelledby="exam-publication-title">
                    <header class="admin-form-section-header">
                        <span class="admin-form-section-icon admin-icon-green" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M3 11v2a2 2 0 0 0 2 2h2l9 4V5l-9 4H5a2 2 0 0 0-2 2ZM7 15l1.5 5H12l-2-4" /><path d="M16 9a4 4 0 0 1 0 6M18.5 7a7 7 0 0 1 0 10" /></svg>
                        </span>
                        <span><h2 id="exam-publication-title">@T["Paramètres de publication"]</h2><p>@T["Contrôlez la visibilité et le contenu de l’examen."]</p></span>
                    </header>

                    <div class="admin-form-grid">
                        <div class="admin-form-field">
                            <label asp-for="Status">@T["Statut"]</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Draft">@T["Brouillon"]</option>
                                <option value="Published">@T["Publié"]</option>
                                <option value="Archived">@T["Archivé"]</option>
                            </select>
                            <span asp-validation-for="Status" class="admin-field-validation"></span>
                            <small class="admin-form-help">@T["Détermine si l’examen est visible dans le catalogue."]</small>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="QuestionsCount">@T["Nombre de questions"]</label>
                            <input asp-for="QuestionsCount" class="form-control" type="number" min="0" max="10000" />
                            <span asp-validation-for="QuestionsCount" class="admin-field-validation"></span>
                            <small class="admin-form-help">@T["Nombre total de questions dans cet examen."]</small>
                        </div>
                    </div>
                </section>

                <section class="admin-card admin-form-section" aria-labelledby="exam-evaluation-title">
                    <header class="admin-form-section-header">
                        <span class="admin-form-section-icon admin-icon-violet" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M4 19V9m8 10V4m8 15v-7" /><path d="M2 21h20" /></svg>
                        </span>
                        <span><h2 id="exam-evaluation-title">@T["Règles d’évaluation"]</h2><p>@T["Configurez les règles de passage de l’examen."]</p></span>
                    </header>

                    <div class="admin-form-grid">
                        <div class="admin-form-field">
                            <label asp-for="DurationMinutes">@T["Durée en minutes"]</label>
                            <input asp-for="DurationMinutes" class="form-control" type="number" min="1" max="1440" placeholder="@T["Ex. 60"]" />
                            <span asp-validation-for="DurationMinutes" class="admin-field-validation"></span>
                            <small class="admin-form-help">@T["Laissez vide si aucune limite de temps."]</small>
                        </div>
                        <div class="admin-form-field">
                            <label asp-for="PassingPercentage">@T["Seuil de réussite (%)"]</label>
                            <input asp-for="PassingPercentage" class="form-control" type="number" min="0" max="100" />
                            <span asp-validation-for="PassingPercentage" class="admin-field-validation"></span>
                            <small class="admin-form-help">@T["Pourcentage minimum de bonnes réponses pour réussir."]</small>
                        </div>
                    </div>
                </section>
            </div>

            <aside class="admin-form-aside" aria-label="@T["Informations contextuelles"]">
                @if (isEdit)
                {
                    <section class="admin-card admin-form-section admin-preview-card" aria-labelledby="exam-preview-title">
                        <header class="admin-form-section-header admin-preview-header">
                            <span class="admin-form-section-icon admin-icon-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M2.5 12s3.3-6 9.5-6 9.5 6 9.5 6-3.3 6-9.5 6-9.5-6-9.5-6Z" /><circle cx="12" cy="12" r="2.5" /></svg>
                            </span>
                            <h2 id="exam-preview-title">@T["Aperçu de l’examen"]</h2>
                            <span class="admin-badge @statusClass">@statusLabel</span>
                        </header>

                        <div class="admin-preview-identity">
                            <h3>@Model.Name</h3>
                            <span class="admin-preview-code">@Model.Code</span>
                            @if (!string.IsNullOrWhiteSpace(Model.Slug))
                            {
                                <a asp-area="" asp-route="PublicExamDetails" asp-route-slug="@Model.Slug" class="admin-preview-link">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.1 0l3-3A5 5 0 0 0 13 2.9l-1.7 1.7M14 11a5 5 0 0 0-7.1 0l-3 3A5 5 0 0 0 11 21.1l1.7-1.7" /></svg>
                                    <span>@Url.RouteUrl("PublicExamDetails", new { slug = Model.Slug })</span>
                                </a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <p>@Model.Description</p>
                            }
                        </div>

                        <div class="admin-preview-stats">
                            <div class="admin-preview-stat">
                                <span class="admin-form-section-icon admin-icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h4" /></svg></span>
                                <span><strong>@Model.QuestionsCount</strong><small>@T["Questions"]</small></span>
                            </div>
                            <div class="admin-preview-stat">
                                <span class="admin-form-section-icon admin-icon-blue" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg></span>
                                <span><strong>@(Model.DurationMinutes.HasValue ? $"{Model.DurationMinutes} min" : T["Non limitée"])</strong><small>@T["Durée"]</small></span>
                            </div>
                            <div class="admin-preview-stat">
                                <span class="admin-form-section-icon admin-icon-green" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 21h8m-4-4v4M5 3h14v7a7 7 0 0 1-14 0V3ZM5 6H2v2a5 5 0 0 0 4 5m13-7h3v2a5 5 0 0 1-4 5" /></svg></span>
                                <span><strong>@Model.PassingPercentage%</strong><small>@T["Seuil de réussite"]</small></span>
                            </div>
                            <div class="admin-preview-stat">
                                <span class="admin-form-section-icon admin-icon-violet" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5zM3 12l9 5 9-5M3 16l9 5 9-5" /></svg></span>
                                <span><strong>@Model.SkillsCount</strong><small>@T["Compétences"]</small></span>
                            </div>
                        </div>

                        <div class="admin-preview-note">
                            <strong>@T["Bon à savoir"]</strong>
                            <p>@T["Cet aperçu reprend les informations principales visibles dans le catalogue des examens."]</p>
                        </div>
                    </section>

                    <section class="admin-card admin-form-section admin-context-card" aria-labelledby="exam-skills-title">
                        <header class="admin-form-section-header">
                            <span class="admin-form-section-icon admin-icon-violet" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5zM3 12l9 5 9-5M3 16l9 5 9-5" /></svg>
                            </span>
                            <h2 id="exam-skills-title">@T["Compétences associées"]</h2>
                            <a asp-area="Admin" asp-controller="Skill" asp-action="Index" asp-route-examId="@Model.Id" class="admin-secondary admin-context-action">@T["Gérer"]</a>
                        </header>
                        @if (Model.SkillsCount == 0)
                        {
                            <div class="admin-empty-state">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5zM3 12l9 5 9-5M3 16l9 5 9-5" /></svg>
                                <strong>@T["Aucune compétence associée"]</strong>
                                <p>@T["Associez des compétences à cet examen pour faciliter la classification."]</p>
                            </div>
                        }
                        else
                        {
                            <p class="admin-context-summary">@Model.SkillsCount @T[Model.SkillsCount == 1 ? "Admin.LinkedSkillSingular" : "Admin.LinkedSkillPlural"]</p>
                        }
                    </section>
                }
                else
                {
                    <section class="admin-card admin-form-section admin-context-card admin-context-tips" aria-labelledby="exam-tips-title">
                        <header class="admin-form-section-header">
                            <span class="admin-form-section-icon admin-icon-blue" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.6 2.6 0 1 1 4.4 1.9c-1.1.8-1.9 1.3-1.9 2.6M12 17h.01" /></svg>
                            </span>
                            <h2 id="exam-tips-title">@T["Conseils"]</h2>
                        </header>
                        <ul class="admin-form-tips">
                            <li>@T["Choisissez un nom clair."]</li>
                            <li>@T["Utilisez un code court."]</li>
                            <li>@T["Le slug doit être unique."]</li>
                            <li>@T["Le seuil doit respecter les limites autorisées."]</li>
                            <li>@T["Vous pourrez ajouter les compétences et les questions après la création."]</li>
                        </ul>
                    </section>
                }
            </aside>
        </div>

        <div class="admin-form-actions">
            <a asp-area="Admin" asp-controller="Exam" asp-action="Index" class="admin-secondary">@T["Annuler"]</a>
            <button type="submit" class="admin-primary admin-primary-action admin-form-save-button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h12l4 4v14H3V3zM7 3v6h10V3M7 21v-7h10v7" /></svg>
                <span>@T["Enregistrer"]</span>
            </button>
        </div>
    </form>
</div>
