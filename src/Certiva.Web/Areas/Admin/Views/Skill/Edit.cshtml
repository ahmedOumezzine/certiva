@model SkillEditViewModel
@{ var isEdit = Model.Id != Guid.Empty; var contextual = Model.ExamId != Guid.Empty && !string.IsNullOrWhiteSpace(Model.ExamName); var title = isEdit ? T["Modifier la compétence"] : T["Nouvelle compétence"]; var returnUrl = contextual ? Url.Action("Details", "Exam", new { area = "Admin", id = Model.ExamId, tab = "skills" }) : Url.Action("Index", "Skill", new { area = "Admin" }); ViewData["Title"] = title; }
@section Breadcrumb { <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Exam" asp-action="Index">@T["Examens"]</a></li>@if (contextual) { <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Exam" asp-action="Details" asp-route-id="@Model.ExamId" asp-route-tab="skills">@Model.ExamName</a></li><li class="breadcrumb-item"><a href="@returnUrl">@T["Compétences"]</a></li> } else { <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Skill" asp-action="Index">@T["Compétences"]</a></li> }<li class="breadcrumb-item active">@title</li> }
<div class="exam-admin admin-page admin-form-page skill-editor-page">
<header class="admin-title-row admin-page-header admin-form-header"><div><span class="admin-eyebrow admin-page-eyebrow">@T["GESTION DES EXAMENS"]</span><h1 class="admin-page-title">@title</h1><p class="admin-page-subtitle">@T["Ajoutez un domaine évalué à l’examen"] @(contextual ? Model.ExamName : string.Empty).</p></div>@if (contextual) { <div class="skill-editor-exam-summary"><strong>@T["Examen"] : @Model.ExamName (@Model.ExamCode)</strong><span>@T["Compétences actuelles"] : @Model.ExistingSkillCount</span><span>@T["Pondération totale"] : <b>@Model.ExistingWeight%</b></span></div> }</header>
<form asp-area="Admin" asp-controller="Skill" asp-action="Save" method="post" class="admin-form">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id" /><input type="hidden" asp-for="ExamId" /><div asp-validation-summary="ModelOnly" class="admin-form-validation-summary" role="alert"></div>
<div class="admin-form-layout skill-editor-layout"><div class="admin-form-main">
<section class="admin-card admin-form-section skill-language-card skill-language-fr"><header class="admin-form-section-header"><span class="skill-language-flag" aria-hidden="true">🇫🇷</span><span><h2>@T["Informations en français"]</h2><p>@T["Saisissez le nom et la description de la compétence en français."]</p></span></header><div class="admin-form-field"><label asp-for="Name">@T["Nom (français)"] *</label><input asp-for="Name" class="form-control" placeholder="@T["Ex. : Appliquer l’ingénierie de prompt et la création de contexte"]" /><span asp-validation-for="Name" class="admin-field-validation"></span></div><div class="admin-form-field"><label asp-for="Description">@T["Description (français)"]</label><textarea asp-for="Description" class="form-control" rows="4" maxlength="4000" placeholder="@T["Ex. : Évaluer la capacité à formuler des prompts efficaces et adaptés au contexte."]"></textarea><span asp-validation-for="Description" class="admin-field-validation"></span></div></section>
<section class="admin-card admin-form-section skill-language-card skill-language-en"><header class="admin-form-section-header"><span class="skill-language-flag" aria-hidden="true">🇬🇧</span><span><h2>@T["Informations en anglais"]</h2><p>@T["Saisissez le nom et la description de la compétence en anglais."]</p></span></header><div class="admin-form-field"><label asp-for="EnglishName">@T["Nom (anglais)"]</label><input asp-for="EnglishName" class="form-control" lang="en" placeholder="@T["Ex. : Apply prompt engineering and context crafting"]" /><span asp-validation-for="EnglishName" class="admin-field-validation"></span></div><div class="admin-form-field"><label asp-for="EnglishDescription">@T["Description (anglais)"]</label><textarea asp-for="EnglishDescription" class="form-control" rows="4" maxlength="4000" lang="en" placeholder="@T["Ex. : Assess the ability to write effective and context-aware prompts."]"></textarea><span asp-validation-for="EnglishDescription" class="admin-field-validation"></span></div></section>
<section class="admin-card admin-form-section"><header class="admin-form-section-header"><span class="admin-form-section-icon admin-icon-violet" aria-hidden="true">▤</span><span><h2>@T["Association et pondération"]</h2><p>@T["Rattachez la compétence à l’examen et définissez son importance."]</p></span></header><div class="admin-form-grid"><div class="admin-form-field"><label>@T["Examen"] *</label><div class="skill-locked-exam">@(contextual ? $"{Model.ExamName} ({Model.ExamCode})" : T["Sélectionner un examen"]) <span aria-hidden="true">🔒</span></div></div><div class="admin-form-field"><label asp-for="Pourcentage">@T["Pondération (%)"] *</label><div class="skill-percent-input"><input asp-for="Pourcentage" class="form-control" type="number" min="0" max="100" /><span>%</span></div><span asp-validation-for="Pourcentage" class="admin-field-validation"></span><small class="admin-form-help">@T["La pondération doit être comprise entre 1 % et 100 %."]</small></div></div></section>
<div class="admin-form-actions"><a href="@returnUrl" class="admin-secondary">@T["Annuler"]</a><button type="submit" class="admin-primary admin-primary-action admin-form-save-button">✓ @T["Enregistrer la compétence"]</button></div></div>
<aside class="admin-form-aside"><section class="admin-card admin-form-section admin-context-card"><header class="admin-form-section-header"><span class="admin-form-section-icon admin-icon-blue" aria-hidden="true">ⓘ</span><h2>@T["Contexte de l’examen"]</h2></header><dl class="skill-context-list"><div><dt>@T["Examen"]</dt><dd>@Model.ExamName</dd></div><div><dt>@T["Code"]</dt><dd>@Model.ExamCode</dd></div><div><dt>@T["Statut"]</dt><dd>@T.EnumLabel(Model.ExamStatus)</dd></div><div><dt>@T["Compétences actuelles"]</dt><dd>@Model.ExistingSkillCount</dd></div><div><dt>@T["Pondération totale"]</dt><dd><span class="admin-percentage">@Model.ExistingWeight%</span></dd></div></dl></section><section class="admin-card admin-form-section admin-context-card admin-context-tips"><header class="admin-form-section-header"><span class="admin-form-section-icon admin-icon-violet" aria-hidden="true">💡</span><h2>@T["Rappels importants"]</h2></header><ul class="admin-form-tips"><li>@T["La compétence doit être liée à l’examen actuel."]</li><li>@T["La pondération est exprimée en pourcentage."]</li><li>@T["La somme des pondérations ne doit pas dépasser 100 %."]</li><li>@T["Les questions pourront ensuite être associées à cette compétence."]</li></ul></section></aside></div></form></div>
